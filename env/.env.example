NEAR_NETWORK_ID=mainnet

AMM_TOKEN1_ID=token1.near
AMM_TOKEN2_ID=token2.near

# TEE mode
TEE_ENABLED=true
SOLVER_REGISTRY_CONTRACT=solver-registry.near
SOLVER_POOL_ID=0
# NEAR_NODE_URLS=

# non-TEE mode
# NEAR_ACCOUNT_ID=solver1.near
# NEAR_PRIVATE_KEY=ed25519:privatekeyprivatekeyprivatekeyprivatekeypriv

# APP_PORT=3000
# LOG_LEVEL=info
# NEAR_NODE_URL=
# RELAY_WS_URL=wss://solver-relay-v2.chaindefuser.com/ws
# RELAY_AUTH_KEY=
# INTENTS_CONTRACT=intents.near
# MARGIN_PERCENT=0.3
# ONE_CLICK_API_ONLY=false

# Cross-chain USDC rebalancing through Xebra (CCTP). Pair two USDC tokens, e.g.
#   AMM_TOKEN1_ID=base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
#   AMM_TOKEN2_ID=arb-0xaf88d065e77c8cc2239327c5edb3a432268e5831.omft.near
# REBALANCE_ENABLED=false
# REBALANCE_DRY_RUN=true
# REBALANCE_TOKEN1_CHAIN=base
# REBALANCE_TOKEN2_CHAIN=arbitrum
# REBALANCE_MIN_SHARE=0.25
# REBALANCE_TARGET_SHARE=0.5
# REBALANCE_MIN_AMOUNT=100
# REBALANCE_MAX_FEE=5
# REBALANCE_SPEED=standard
# REBALANCE_INTERVAL_SEC=300
# live runs only:
# ONECLICK_API_KEY=
# REBALANCE_EVM_PRIVATE_KEY=0x...
# REBALANCE_RPC_URLS=base=https://...,arbitrum=https://...
